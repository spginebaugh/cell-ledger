{
  "openapi": "3.1.0",
  "info": {
    "title": "cell-ledger",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/geo/search": {
      "post": {
        "tags": [
          "geo"
        ],
        "summary": "Search Geo",
        "description": "Search GEO for human bulk RNA-seq series that have NCBI raw counts.",
        "operationId": "searchGeo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "operationId": "createSession",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/datasets": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Collect Datasets",
        "description": "Download the given series into the session; each comes back ready or excluded.",
        "operationId": "collectDatasets",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List Datasets",
        "operationId": "listDatasets",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatasetRecord"
                  },
                  "title": "Response Listdatasets"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/datasets/{gse}/files/{name}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get File Url",
        "description": "Short-lived download link for one stored file.",
        "operationId": "getDatasetFileUrl",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Session Id"
            }
          },
          {
            "name": "gse",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^GSE\\d+$",
              "title": "Gse"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUrl"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "delete": {
        "tags": [
          "sessions"
        ],
        "summary": "Delete Session",
        "operationId": "deleteSession",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollectRequest": {
        "properties": {
          "gses": {
            "items": {
              "type": "string",
              "pattern": "^GSE\\d+$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Gses"
          }
        },
        "type": "object",
        "required": [
          "gses"
        ],
        "title": "CollectRequest"
      },
      "CollectResponse": {
        "properties": {
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/CollectedDataset"
            },
            "type": "array",
            "title": "Datasets"
          }
        },
        "type": "object",
        "required": [
          "datasets"
        ],
        "title": "CollectResponse"
      },
      "CollectedDataset": {
        "properties": {
          "record": {
            "$ref": "#/components/schemas/DatasetRecord"
          },
          "local_dir": {
            "type": "string",
            "title": "Local Dir"
          },
          "uploaded": {
            "type": "boolean",
            "title": "Uploaded"
          },
          "upload_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Error"
          }
        },
        "type": "object",
        "required": [
          "record",
          "local_dir",
          "uploaded"
        ],
        "title": "CollectedDataset"
      },
      "CountsCheck": {
        "properties": {
          "n_genes": {
            "type": "integer",
            "title": "N Genes"
          },
          "n_columns": {
            "type": "integer",
            "title": "N Columns"
          },
          "all_nonneg_integers": {
            "type": "boolean",
            "title": "All Nonneg Integers"
          },
          "columns_not_in_soft": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns Not In Soft"
          }
        },
        "type": "object",
        "required": [
          "n_genes",
          "n_columns",
          "all_nonneg_integers",
          "columns_not_in_soft"
        ],
        "title": "CountsCheck"
      },
      "DatasetExclusion": {
        "type": "string",
        "enum": [
          "no_ncbi_counts",
          "counts_not_integer",
          "no_eligible_samples"
        ],
        "title": "DatasetExclusion"
      },
      "DatasetRecord": {
        "properties": {
          "gse": {
            "type": "string",
            "title": "Gse"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'ready' or 'excluded'"
          },
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/DatasetExclusion"
            },
            "type": "array",
            "title": "Exclusions"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "overall_design": {
            "type": "string",
            "title": "Overall Design",
            "default": ""
          },
          "pubmed_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pubmed Ids"
          },
          "files": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FileRecord"
            },
            "type": "object",
            "title": "Files",
            "description": "'counts', 'soft'"
          },
          "counts_check": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CountsCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/SampleRecord"
            },
            "type": "array",
            "title": "Samples"
          },
          "n_eligible": {
            "type": "integer",
            "title": "N Eligible",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "gse",
          "status"
        ],
        "title": "DatasetRecord"
      },
      "FileRecord": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "md5": {
            "type": "string",
            "title": "Md5"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "downloaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Downloaded At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url",
          "md5",
          "bytes",
          "downloaded_at"
        ],
        "title": "FileRecord"
      },
      "FileUrl": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "url",
          "expires_in"
        ],
        "title": "FileUrl"
      },
      "GeoSeriesHit": {
        "properties": {
          "gse": {
            "type": "string",
            "pattern": "^GSE\\d+$",
            "title": "Gse"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "taxa": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Taxa"
          },
          "series_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Series Types"
          },
          "n_samples": {
            "type": "integer",
            "title": "N Samples"
          },
          "published": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published"
          },
          "pubmed_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pubmed Ids"
          },
          "matched_queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Queries",
            "description": "Which submitted queries found this series"
          },
          "mixed_organism": {
            "type": "boolean",
            "title": "Mixed Organism",
            "description": "True when the series also has non-human samples; they are excluded at fetch time.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "gse",
          "title",
          "summary",
          "taxa",
          "series_types",
          "n_samples",
          "published",
          "pubmed_ids",
          "matched_queries",
          "mixed_organism"
        ],
        "title": "GeoSeriesHit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "core_version": {
            "type": "string",
            "title": "Core Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "api_version",
          "core_version"
        ],
        "title": "Health"
      },
      "QueryStats": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "term": {
            "type": "string",
            "title": "Term",
            "description": "Exact term sent to esearch, for provenance"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Series in GEO matching the term"
          },
          "returned": {
            "type": "integer",
            "title": "Returned"
          }
        },
        "type": "object",
        "required": [
          "query",
          "term",
          "total",
          "returned"
        ],
        "title": "QueryStats"
      },
      "SampleExclusion": {
        "type": "string",
        "enum": [
          "not_human",
          "not_rna_seq",
          "not_in_counts"
        ],
        "title": "SampleExclusion"
      },
      "SampleRecord": {
        "properties": {
          "gsm": {
            "type": "string",
            "title": "Gsm"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "organism": {
            "type": "string",
            "title": "Organism"
          },
          "library_strategy": {
            "type": "string",
            "title": "Library Strategy"
          },
          "characteristics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Characteristics"
          },
          "in_counts": {
            "type": "boolean",
            "title": "In Counts"
          },
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/SampleExclusion"
            },
            "type": "array",
            "title": "Exclusions"
          }
        },
        "type": "object",
        "required": [
          "gsm",
          "title",
          "source_name",
          "organism",
          "library_strategy",
          "characteristics",
          "in_counts"
        ],
        "title": "SampleRecord",
        "description": "One GSM as GEO describes it. Values are verbatim from the SOFT file."
      },
      "SearchRequest": {
        "properties": {
          "queries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Queries"
          },
          "limit_per_query": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Limit Per Query",
            "default": 50
          },
          "since": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 2000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Since",
            "description": "Published in or after"
          }
        },
        "type": "object",
        "required": [
          "queries"
        ],
        "title": "SearchRequest"
      },
      "SearchResult": {
        "properties": {
          "queries": {
            "items": {
              "$ref": "#/components/schemas/QueryStats"
            },
            "type": "array",
            "title": "Queries"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/GeoSeriesHit"
            },
            "type": "array",
            "title": "Hits"
          }
        },
        "type": "object",
        "required": [
          "queries",
          "hits"
        ],
        "title": "SearchResult"
      },
      "SessionInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at"
        ],
        "title": "SessionInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
