# Copy to .env. All API settings are prefixed CELL_LEDGER_ (see apps/api/src/cell_ledger_api/settings.py).
# Local and Fly run the same image with the same variables; fly.toml sets the non-secret ones
# and `fly secrets` the rest. Keep this file in sync with both.

# ---------------------------------------------------------------------------- required
# Postgres is the only record of sessions, datasets and runs; Supabase Storage is the only
# durable copy of their files. The API refuses to start without both.
#
# Local stack (`mise run supabase:start`, ports from supabase/config.toml). The secret key is
# the Supabase CLI's fixed demo service_role JWT; it only works against a local stack.
CELL_LEDGER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres
CELL_LEDGER_SUPABASE_URL=http://127.0.0.1:57321
CELL_LEDGER_SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
CELL_LEDGER_SUPABASE_BUCKET=sessions
#
# Cloud project instead (what Fly uses; see docs/deploy.md): the Session-pooler connection
# string from the dashboard (IPv4-friendly) and the sb_secret_... key. Never commit either.
# CELL_LEDGER_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# CELL_LEDGER_SUPABASE_URL=https://<ref>.supabase.co
# CELL_LEDGER_SUPABASE_SECRET_KEY=sb_secret_...

# Local cache of GEO downloads and run outputs. Safe to delete; refilled from Storage/NCBI.
CELL_LEDGER_DATA_DIR=data

# NCBI E-utilities key (10 req/s instead of 3). Never commit.
CELL_LEDGER_NCBI_API_KEY=key_here

# Serve the built UI from the API (what the container does). Leave unset for `mise run dev`,
# where Vite serves the UI and proxies /api. `mise run serve` sets it for you.
# CELL_LEDGER_WEB_DIST=apps/web/dist

# ----------------------------------------------------------------------------- optional
# CELL_LEDGER_SESSION_TTL_HOURS=24
# CELL_LEDGER_SWEEP_INTERVAL_MINUTES=60
# CELL_LEDGER_MAX_DATASETS_PER_REQUEST=10
# CELL_LEDGER_MAX_CONCURRENT_DOWNLOADS=3
# Pipeline runs are `cell-ledger run` subprocesses: cap them by memory (a few GB each).
# CELL_LEDGER_MAX_CONCURRENT_RUNS=2
# CELL_LEDGER_RUN_N_CPUS=        # unset -> pipeline default (all cores)
# CELL_LEDGER_RUN_TIMEOUT_MINUTES=30
# Cross-dataset comparisons are `cell-ledger run-set --compare-only` subprocesses.
# CELL_LEDGER_COMPARE_TIMEOUT_MINUTES=15
# How many restarts may re-dispatch an interrupted collect or run before it is failed.
# CELL_LEDGER_MAX_ATTEMPTS=2

# Anthropic (Claude) for the discover and design steps (backend only). Without it the UI
# falls back to pasting accessions and uploading a design file.
CELL_LEDGER_ANTHROPIC_API_KEY=
# CELL_LEDGER_ANTHROPIC_MODEL=claude-opus-5-5
# CELL_LEDGER_ANTHROPIC_EFFORT=medium

# Exa search API (backend only).
CELL_LEDGER_EXA_API_KEY=
